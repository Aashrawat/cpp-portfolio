# Copy to .env.local and fill in your values.

MONGODB_URI=
JWT_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:8080
OPENAI_API_KEY=

# Mailgun — https://app.mailgun.com/
# 1. Sending → Domains → copy your domain (e.g. sandboxXXXXXXXX.mailgun.org)
# 2. Settings → API keys → Private API key (often starts with key-)
# 3. Sandbox only: add recipient emails under Sending → Domain → Authorized recipients
MAILGUN_DOMAIN=sandboxXXXXXXXX.mailgun.org
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_FROM=Nuvio <postmaster@sandboxXXXXXXXX.mailgun.org>
# Use if your Mailgun account is in the EU region:
# MAILGUN_API_BASE=https://api.eu.mailgun.net
